# Supabase — projeto site-system-ir (IR Core), fonte central futura para
# apps/sistema e apps/site. Nunca o banco do Altnix Informativo ou da
# Altnix Platform.
#
# Copie para .env.local (nunca commitado) e preencha com os valores reais.
# A publishable key é segura para uso no cliente. NUNCA coloque aqui um
# token pessoal (sbp_...) — essa credencial só existe localmente, fora do
# repositório, quando realmente necessária para rodar a CLI (ex.:
# `supabase link`, migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública deste próprio painel (apps/sistema) — usada só para montar o
# link de retorno dos convites de usuário (Fase 20). Opcional; sem ela, o
# convite usa http://localhost:3001 como padrão.
NEXT_PUBLIC_SISTEMA_URL=

# Chave administrativa (Admin API do Supabase) — usada SOMENTE no servidor
# (Server Actions em apps/sistema/src/lib/supabase/admin.ts, nunca
# importada por nenhum Client Component; `import "server-only"` faz o
# build falhar se isso acontecer por engano). NUNCA prefixar com
# NEXT_PUBLIC_ — isso a exporia ao navegador. NUNCA commitar o valor real.
# Sem esta variável definida, a criação/convite de usuários fica desligada
# na interface (mensagem clara, sem quebrar o painel) — o resto do sistema
# funciona normalmente sem ela.
SUPABASE_SERVICE_ROLE_KEY=


# Jornal Online — PDFs das edições ficam no Google Drive, não no Supabase
# Storage. Para pasta comum do "Meu Drive", prefira OAuth da própria conta
# do jornal (client id/secret + refresh token). Service account fica como
# alternativa para Shared Drive/Google Workspace.
DRIVE_PUBLIC_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=


# Asaas — cobrança Pix e confirmação automática por webhook.
# Valores reais ficam somente na Vercel/.env.local, nunca no Git.
ASAAS_ENV=sandbox
ASAAS_API_KEY_SANDBOX=
ASAAS_API_KEY_PRODUCTION=
ASAAS_WEBHOOK_TOKEN=

# WhatsApp Cloud API (Meta) — confirmação automática de pagamento.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BILLING_LANGUAGE=pt_BR
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE=confirmacao_pagamento_ir


# Cloudflare R2 — bucket de IMAGENS/mídias do site (fotos, capas de
# matérias etc.), usado por apps/sistema/src/providers/r2/mediaStorage.r2.ts.
# Nunca reaproveitar essas credenciais para o bucket de edições abaixo.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Cloudflare R2 — bucket EXCLUSIVO do Jornal Online (PDFs das edições e
# capas geradas), usado por
# apps/sistema/src/providers/r2/editionArchive.r2.ts.
# Decisão vigente: bucket `jornal-ir-edicoes` em uma SEGUNDA CONTA
# Cloudflare, separada da conta das imagens — por isso o endpoint também é
# exclusivo (R2_EDITIONS_ENDPOINT), não o mesmo da conta de imagens.
# Se as cinco variáveis abaixo estiverem ausentes, o sistema usa o bucket
# de imagens como compatibilidade legada; se R2_EDITIONS_BUCKET for
# preenchido (bucket exclusivo), as demais R2_EDITIONS_* passam a ser
# obrigatórias — sem fallback silencioso para as credenciais/endpoint
# antigos. R2_EDITIONS_PUBLIC_BASE_URL só deve ser preenchida depois de
# configurar e testar o domínio público do bucket novo.
R2_EDITIONS_ENDPOINT=
R2_EDITIONS_BUCKET=
R2_EDITIONS_ACCESS_KEY_ID=
R2_EDITIONS_SECRET_ACCESS_KEY=
R2_EDITIONS_PUBLIC_BASE_URL=
