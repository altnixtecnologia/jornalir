# Supabase — projeto site-system-ir (IR Core). Preparado para quando o
# portal público passar a consumir dados reais (fase futura — ver
# docs/DATABASE-IR-CORE.md); apps/site ainda usa IndexedDB/mocks nesta fase.
#
# Copie para .env.local (nunca commitado) e preencha com os valores reais.
# A publishable key é segura para uso no cliente. NUNCA coloque aqui um
# token pessoal (sbp_...) ou a SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jornal Online — entrega pública de PDFs/capas do bucket dedicado
# `jornal-ir-edicoes` (segunda conta Cloudflare), via rota própria do portal
# (/api/jornal-online/editions/[id]/pdf|cover). O bucket continua PRIVADO —
# não existe R2_EDITIONS_PUBLIC_BASE_URL aqui de propósito.
#
# IMPORTANTE: gere um token R2 específico, SOMENTE LEITURA, restrito a este
# bucket. NUNCA reutilize aqui a credencial administrativa de escrita usada
# pelo apps/sistema (upload/exclusão) — são variáveis de ambiente separadas,
# em projetos Vercel separados. Ver docs/JORNAL-ONLINE-ARMAZENAMENTO-E-LEITOR.md.
R2_EDITIONS_ENDPOINT=
R2_EDITIONS_BUCKET=
R2_EDITIONS_ACCESS_KEY_ID=
R2_EDITIONS_SECRET_ACCESS_KEY=
